# Copie para .env (desenvolvimento local). Na Vercel, as variaveis ficam em
# Project Settings > Environment Variables (DATABASE_URL e DATABASE_URL_UNPOOLED
# sao criadas pela integracao do Neon).

# Conexao com pool (usada pela API)
DATABASE_URL="postgresql://usuario:senha@host/banco?sslmode=require"
# Conexao direta, sem pool (usada por prisma migrate)
DATABASE_URL_UNPOOLED="postgresql://usuario:senha@host/banco?sslmode=require"
# Segredo dos tokens de login (equipe e clientes). Minimo de 24 caracteres em producao.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="troque-por-um-segredo-longo-e-aleatorio"

# Opcionais
# JWT_EXPIRES_IN="7d"            # sessao da equipe
# JWT_CLIENTE_EXPIRES_IN="30d"   # sessao do cliente
# TZ_NEGOCIO="America/Sao_Paulo" # fuso usado para "hoje" e para a agenda
# CORS_ORIGINS=""                # so se o site rodar em outro dominio que nao o da API
# PORT=3341                      # porta da API no desenvolvimento local (npm run dev:api)

# Pagamento online do agendamento (Mercado Pago). O app e da SMG; a barbearia conecta a
# conta dela em Gestao > Configuracoes > Pagamento online. Sem estas variaveis, o site
# segue agendando com pagamento na barbearia.
# SITE_URL="https://cidadenobre.147-93-145-137.sslip.io"   # volta do pagamento e do OAuth
# MERCADO_PAGO_CLIENT_ID=""
# MERCADO_PAGO_CLIENT_SECRET=""
# MERCADO_PAGO_OAUTH_REDIRECT_URI="https://cidadenobre.147-93-145-137.sslip.io/api/mercado-pago/oauth/callback"
# MERCADO_PAGO_TAXA_PLATAFORMA_PCT=2   # comissao da SMG por pagamento (0 desliga)
# MERCADO_PAGO_PRAZO_MINUTOS=30        # tempo para pagar antes de liberar o horario
