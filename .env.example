# Copie para .env (desenvolvimento local). Na Vercel, as variaveis ficam em
# Project Settings > Environment Variables (DATABASE_URL e DATABASE_URL_UNPOOLED
# sao criadas pela integracao do Neon).

# Conexao com pool (usada pela API)
DATABASE_URL="postgresql://usuario:senha@host/banco?sslmode=require"
# Conexao direta, sem pool (usada por prisma migrate)
DATABASE_URL_UNPOOLED="postgresql://usuario:senha@host/banco?sslmode=require"
# Segredo dos tokens de login (equipe e clientes). Minimo de 24 caracteres em producao.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="troque-por-um-segredo-longo-e-aleatorio"

# Opcionais
# JWT_EXPIRES_IN="7d"            # sessao da equipe
# JWT_CLIENTE_EXPIRES_IN="30d"   # sessao do cliente
# TZ_NEGOCIO="America/Sao_Paulo" # fuso usado para "hoje" e para a agenda
# CORS_ORIGINS=""                # so se o site rodar em outro dominio que nao o da API
# PORT=3341                      # porta da API no desenvolvimento local (npm run dev:api)
